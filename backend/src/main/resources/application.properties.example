spring.application.name=gameshelf
server.port=8080

# IGDB
igdb.api.base-url=https://api.igdb.com/v4
igdb.auth-url=https://id.twitch.tv/oauth2/token
igdb.client-id=${IGDB_CLIENT_ID}
igdb.client-secret=${IGDB_CLIENT_SECRET}

# JWT
jwt.secret=${JWT_SECRET}
jwt.expiration=86400000

# FRONTEND
app.frontend-url=${FRONTEND_URL:http://localhost:5173}

# DATABASE
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/gameshelf}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true